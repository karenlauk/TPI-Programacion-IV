# VARIABLES DE ENTORNO

# BASE DE DATOS
# Utiliza psycopg2-binary, instalado en requirements.txt
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5433/foodstore

# JWT
# Reemplazar por una clave aleatoria de al menos 32 caracteres
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# ADMINISTRADOR INICIAL
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@foodstore.local
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=FoodStore